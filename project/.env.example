# 复制本文件为 project/.env，填写真实密钥。不要提交 .env。
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com
WEB_SEARCH_ENABLED=true
# 首次启动下载 BM25 如需镜像，可取消下一行注释。
# HF_ENDPOINT=https://hf-mirror.com

# 账号由网站注册，密码以哈希保存到 account_data/accounts.sqlite3。
# 旧版 WEB_AUTH_REQUIRED / WEB_AUTH_USERNAME / WEB_AUTH_PASSWORD 已不再使用。

# Cloudflare Turnstile 正式站点密钥；从 Cloudflare 控制台创建 Managed 小组件获取。
# Site Key 可公开；Secret Key 仅保存在服务器 .env，不能发给前端或提交到 Git。
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=knowva.xin

# 每个账号的服务端资源限制；额度按北京时间零点重置。
DAILY_QUESTIONS=30
DAILY_EMBEDDING_CHARS=500000
DAILY_UPLOAD_MB=50
MAX_UPLOAD_MB=10
MAX_UPLOAD_BATCH=3
MAX_DOCUMENTS=30
USER_STORAGE_MB=100
MAX_PDF_PAGES=100
MAX_DOCUMENT_CHARS=200000
MAX_DOCUMENT_CHUNKS=600
MAX_QUESTION_CHARS=4000
MODEL_MAX_OUTPUT_TOKENS=2048
# 2 核 2 GB 先保留以下默认值，压测后再调整。
MAX_ACTIVE_TASKS=2
# 流式回答内部至少需要 2 个执行线程；全站任务数量由 MAX_ACTIVE_TASKS 限制。
GRAPH_MAX_CONCURRENCY=2
MAX_CACHED_WORKSPACES=3
WORKSPACE_IDLE_SECONDS=600
WORKSPACE_MAX_AGE_SECONDS=3600
UPLOAD_TTL_SECONDS=3600
QUEUE_MAX_SIZE=16
MAX_UPLOAD_CACHE_MB=256
MIN_DISK_FREE_MB=256
